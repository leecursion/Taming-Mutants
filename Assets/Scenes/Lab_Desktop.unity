--- !u!114 &1999102669
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1999102663}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3a4685fb29e3c37449c5157552b2ea98, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  useOralCheck: 1
  oralCheckClient: {fileID: 0}
  maxOralRetries: 1
  allowTypedOralAnswersWithoutMicrophone: 0
  oralIntroLine: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC5F0\uAD6C\uC6D0\uB2D8\uC758 \uC0DD\uAC01\uC744
    \uB4E4\uB824\uC8FC\uC138\uC694."
  oralListenPrompt: "\uB9C8\uC774\uD06C\uB85C \uB9D0\uD55C \uB4A4, \uC54C\uC544\uB4E4\uC740
    \uB0B4\uC6A9\uC774 \uB9DE\uB294\uC9C0 \uD655\uC778\uD574 \uC8FC\uC138\uC694.
    \uAE00\uB85C \uACE0\uCCD0\uB3C4 \uAD1C\uCC2E\uC544\uC694."
  oralPassLine: "\uC65C \uD1B5\uD588\uB294\uC9C0 \uC790\uAE30 \uB9D0\uB85C \uC798
    \uC124\uBA85\uD558\uC168\uC5B4\uC694."
  oralSkipLine: "\uC9C0\uAE08\uC740 \uC124\uBA85\uC744 \uC815\uB9AC\uD558\uACE0 \uB2E4\uC74C\uC73C\uB85C
    \uB118\uC5B4\uAC08\uAC8C\uC694."
  visual: {fileID: 1999102666}
  bubble: {fileID: 831819909}
  follower: {fileID: 1999102667}
  client: {fileID: 733304436}
  session: {fileID: 733304432}
  mutationHighlighter: {fileID: 0}
  dockingQuest: {fileID: 0}
  levelController: {fileID: 0}
  compoundPanel: {fileID: 0}
  factProvider: {fileID: 0}
  greetingLines:
  - "\uC548\uB155\uD558\uC138\uC694. \uC624\uB298\uBD80\uD130 \uC774 \uACFC\uD559\uC2E4\uC5D0\uC11C
    \uD568\uAED8 \uC77C\uD560 AI \uB3C4\uC6B0\uBBF8\uC608\uC694."
  - "\uADF8\uB7F0\uB370 \uBC29\uAE08 \uC13C\uC11C\uC5D0 \uC774\uC0C1\uD55C \uC2E0\uD638\uAC00
    \uC7A1\uD614\uC5B4\uC694. \uC6B0\uB9AC \uBAB8 \uC138\uD3EC \uC548\uC5D0\uC11C
    \uBB54\uAC00 \uD3C9\uC18C\uC640 \uB2E4\uB974\uAC8C \uC6C0\uC9C1\uC774\uACE0 \uC788\uB300\uC694."
  - "\uC5B4\uB5A4 \uC0AC\uAC74\uBD80\uD130 \uC870\uC0AC\uD574 \uBCFC\uAE4C\uC694?"
  announceStages: 1
  elaborateWithLlm: 1
  playQuestScenario: 1
  introduceTargetWithLlm: 1
  targetIntroPrompt: "\uD50C\uB808\uC774\uC5B4\uAC00 '{title}' \uC0AC\uAC74\uC744
    \uACE8\uB790\uC5B4\uC694. {gene} \uB2E8\uBC31\uC9C8\uC774 \uC6B0\uB9AC \uBAB8\uC5D0\uC11C
    \uC6D0\uB798 \uBB34\uC2A8 \uC77C\uC744 \uD558\uB294\uC9C0, \uADF8\uB9AC\uACE0
    {mutation} \uBCC0\uC774\uAC00 \uC0DD\uAE30\uBA74 \uBB34\uC5C7\uC774 \uB2EC\uB77C\uC9C0\uB294\uC9C0
    \uC77C\uC0C1\uC801\uC778 \uBE44\uC720\uB97C \uB4E4\uC5B4 \uC124\uBA85\uD574\uC8FC\uC138\uC694.
    \uC544\uC9C1 \uB2E8\uACC4\uBCC4 \uACF5\uB7B5\uC774\uB098 \uC815\uB2F5 \uBB3C\uC9C8\uC740
    \uC54C\uB824\uC8FC\uC9C0 \uB9C8\uC138\uC694."
  explainDockingWithLlm: 1
  dockingSuccessPrompt: "\uD50C\uB808\uC774\uC5B4\uAC00 '{compound}'\uB85C \uB3C4\uD0B9\uC5D0
    \uC131\uACF5\uD588\uC5B4\uC694. \uC774 \uBB3C\uC9C8\uC774 \uC65C \uD1B5\uD588\uB294\uC9C0,
    \uADF8\uB9AC\uACE0 \uC774\uAC8C \uD658\uC790\uC5D0\uAC8C \uC5B4\uB5A4 \uC758\uBBF8\uC778\uC9C0
    \uCE6D\uCC2C\uC744 \uC11E\uC5B4 \uC124\uBA85\uD574\uC8FC\uC138\uC694."
  dockingFailurePrompt: "\uD50C\uB808\uC774\uC5B4\uAC00 '{compound}'\uB97C \uC2DC\uB3C4\uD588\uB294\uB370
    \uC2E4\uD328\uD588\uC5B4\uC694. \uC65C \uC774\uB7F0 \uACB0\uACFC\uAC00 \uB098\uC654\uB294\uC9C0
    '\uD604\uC7AC \uC0C1\uD669'\uC5D0 \uC801\uD78C \uD310\uC815 \uB0B4\uC6A9\uC744
    \uADFC\uAC70\uB85C \uC124\uBA85\uD558\uACE0, \uB2E4\uC74C\uC5D0 \uBB34\uC5C7\uC744
    \uB208\uC5EC\uACA8\uBCF4\uBA74 \uC88B\uC744\uC9C0 \uD55C \uAC78\uC74C\uB9CC \uC774\uB04C\uC5B4
    \uC8FC\uC138\uC694. \uC815\uB2F5 \uBB3C\uC9C8\uC740 \uC54C\uB824\uC8FC\uC9C0
    \uB9C8\uC138\uC694."
  narrateStructureLevels: 1
  elaborateStructureLevelsWithLlm: 1
  ribbonLine: "\uC9C0\uAE08 \uBCF4\uC774\uB294 \uAC8C \uB2E8\uBC31\uC9C8 \uC804\uCCB4
    \uBAA8\uC591\uC774\uC5D0\uC694. \uC0C9\uC740 \uC904\uAE30\uAC00 \uC5B4\uB5A4
    \uBAA8\uC591\uC73C\uB85C \uC811\uD614\uB294\uC9C0 \uC54C\uB824\uC918\uC694 \u2014
    \uC790\uC8FC\uC0C9\uC740 \uB3CC\uB3CC \uB9D0\uB9B0 \uB098\uC120, \uB178\uB780\uC0C9\uC740
    \uB0A9\uC791\uD55C \uAC00\uB2E5\uC774\uC5D0\uC694. \uAD81\uAE08\uD55C \uACF3\uC744
    \uB20C\uB7EC\uBCF4\uBA74 \uADF8 \uBD80\uBD84\uB9CC \uD655\uB300\uD574\uC11C \uBCFC
    \uC218 \uC788\uC5B4\uC694."
  helixLine: "\uC88B\uC544\uC694, \uACE0\uB974\uC2E0 \uAD6C\uAC04\uB9CC \uD06C\uAC8C
    \uB744\uC6E0\uC5B4\uC694. \uC774\uB807\uAC8C \uB3CC\uB3CC \uB9D0\uB9B0 \uBAA8\uC591\uC744
    \uB098\uC120\uC774\uB77C\uACE0 \uBD88\uB7EC\uC694. \uD55C \uBC88 \uB354 \uB204\uB974\uBA74
    \uC774 \uC548\uC758 \uC6D0\uC790\uAE4C\uC9C0 \uB4E4\uC5B4\uAC08 \uC218 \uC788\uC5B4\uC694."
  strandLine: "\uC88B\uC544\uC694, \uACE0\uB974\uC2E0 \uAD6C\uAC04\uB9CC \uD06C\uAC8C
    \uB744\uC6E0\uC5B4\uC694. \uC774\uB807\uAC8C \uB0A9\uC791\uD55C \uD654\uC0B4\uD45C\uCC98\uB7FC
    \uBED7\uC740 \uBAA8\uC591\uC744 \uAC00\uB2E5\uC774\uB77C\uACE0 \uBD88\uB7EC\uC694.
    \uC5EC\uB7EC \uAC00\uB2E5\uC774 \uB098\uB780\uD788 \uBD99\uC5B4\uC11C \uB113\uC740
    \uD310\uC744 \uC774\uB904\uC694. \uD55C \uBC88 \uB354 \uB204\uB974\uBA74 \uC774
    \uC548\uC758 \uC6D0\uC790\uAE4C\uC9C0 \uB4E4\uC5B4\uAC08 \uC218 \uC788\uC5B4\uC694."
  loopLine: "\uC88B\uC544\uC694, \uACE0\uB974\uC2E0 \uAD6C\uAC04\uB9CC \uD06C\uAC8C
    \uB744\uC6E0\uC5B4\uC694. \uC5EC\uAE30\uB294 \uB098\uC120\uB3C4 \uAC00\uB2E5\uB3C4
    \uC544\uB2CC \uB290\uC2A8\uD55C \uACE0\uB9AC\uC608\uC694. \uBAA8\uC591\uC774
    \uC815\uD574\uC838 \uC788\uC9C0 \uC54A\uC544\uC11C \uC798 \uD718\uB294 \uBD80\uBD84\uC778\uB370,
    \uADF8\uB798\uC11C \uBB34\uC5B8\uAC00\uB97C \uBD99\uC7A1\uB294 \uC790\uB9AC\uAC00
    \uB418\uACE4 \uD574\uC694. \uD55C \uBC88 \uB354 \uB204\uB974\uBA74 \uC774 \uC548\uC758
    \uC6D0\uC790\uAE4C\uC9C0 \uB4E4\uC5B4\uAC08 \uC218 \uC788\uC5B4\uC694."
  aminoAcidLine: "\uC5EC\uAE30\uAC00 \uAC00\uC7A5 \uC548\uCABD\uC774\uC5D0\uC694.
    \uC774\uC81C \uACF5 \uD558\uB098\uD558\uB098\uAC00 \uC6D0\uC790\uC608\uC694.
    \uC0C9\uC740 AI\uAC00 \uC774 \uBD80\uBD84 \uBAA8\uC591\uC744 \uC5BC\uB9C8\uB098
    \uD655\uC2E0\uD558\uB294\uC9C0 \uBCF4\uC5EC\uC918\uC694 \u2014 \uD30C\uB791\uC740
    \uC790\uC2E0 \uC788\uB2E4\uB294 \uB73B\uC774\uACE0, \uB178\uB791\uC774\uB098
    \uC8FC\uD669\uC740 \uD655\uC2E0\uC774 \uB35C\uD558\uB2E4\uB294 \uB73B\uC774\uC5D0\uC694."
  blockInteractionWhileSpeaking: 1
