  factProvider: {fileID: 0}
  greetingLines:
  - "\uC548\uB155\uD558\uC138\uC694. \uC624\uB298\uBD80\uD130 \uC774 \uACFC\uD559\uC2E4\uC5D0\uC11C
    \uD568\uAED8 \uC77C\uD560 AI \uB3C4\uC6B0\uBBF8\uC608\uC694."
  - "\uADF8\uB7F0\uB370 \uBC29\uAE08 \uC13C\uC11C\uC5D0 \uC774\uC0C1\uD55C \uC2E0\uD638\uAC00
