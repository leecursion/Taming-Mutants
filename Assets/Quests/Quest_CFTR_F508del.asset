      mood: 2
      action: 2
      llmPrompt: 
    - line: "\uC124\uACC4\uB3C4\uC5D0\uC11C 508\uBC88 \uAE00\uC790\uAC00 \uD1B5\uC9F8\uB85C
        \uBE60\uC84C\uAC70\uB4E0. \uBC18\uC9DD\uC774\uB294 507\uBC88\uACFC 509\uBC88
