  questId: kras_g12c
  title: KRAS G12C
  subtitle: "\uC0AC\uAC74 1: \uBA48\uCD94\uC9C0 \uC54A\uB294 \uC138\uD3EC \uC131\uC7A5"
  gene: KRAS
  mutation: G12C
  summary: "\uC6B0\uB9AC \uBAB8 \uC138\uD3EC\uC5D0\uC11C \uC774\uC0C1\uD55C \uC2E0\uD638\uAC00
    \uC7A1\uD614\uC5B4\uC694. \uC138\uD3EC\uC758 '\uC131\uC7A5 \uC2A4\uC704\uCE58'
    \uC5ED\uD560\uC744 \uD558\uB294 KRAS\uB77C\uB294 \uB2E8\uBC31\uC9C8\uC774 \uACE0\uC7A5
    \uB098\uC11C, \uC138\uD3EC\uAC00 \uBA48\uCD94\uC9C0 \uC54A\uACE0 \uACC4\uC18D
    \uC790\uB77C\uACE0 \uC788\uB300\uC694. \uC2E0\uC785 \uC5F0\uAD6C\uC6D0\uC778
    \uB2F9\uC2E0\uC774 \uC774 \uC0AC\uAC74\uC744 \uD568\uAED8 \uD574\uACB0\uD574
    \uC8FC\uC138\uC694!"
  difficulty: 3
  accent: {r: 0.35, g: 0.85, b: 1, a: 1}
  structureStreamingPath: structures/P01116.json
  mutationResidueIds: 0c000000
  targetPocketLabel: "\uC2A4\uC704\uCE58\uB97C \uB044\uB294 \uC5F4\uC1E0 \uAD6C\uBA4D
    (Switch-II Pocket)"
  scenario:
    caseCode: CASE-01
    place: "\uC2DC\uB9BD\uBCD1\uC6D0 3\uCE35 \uC815\uBC00\uAC80\uC0AC\uC2E4"
    client: "\uD638\uD761\uAE30\uB0B4\uACFC \uD55C\uC9C0\uC6B0 \uC120\uC0DD\uB2D8"
    premise: "\uAC00\uC0C1\uC758 \uC0AC\uAC74\uC774\uB2E4. \uD55C \uD658\uC790\uC758
      \uD3D0\uC5D0\uC11C \uC138\uD3EC \uB369\uC5B4\uB9AC\uAC00 \uBA48\uCD94\uC9C0
      \uC54A\uACE0 \uCEE4\uC9C0\uACE0 \uC788\uB2E4. \uC6B0\uB9AC \uBAB8\uC740 \uBD84\uBA85\uD788
      '\uC774\uC81C \uADF8\uB9CC \uC790\uB77C'\uB77C\uB294 \uC2E0\uD638\uB97C \uBCF4\uB0B4\uB294\uB370
      \uADF8 \uC138\uD3EC\uB4E4\uB9CC \uC804\uD600 \uB4E3\uC9C0 \uC54A\uB294\uB2E4.
      \uBCD1\uC6D0\uC5D0\uC11C \uAEBC\uB0B4 \uC628 \uC138\uD3EC\uB97C \uC5F0\uAD6C\uC2E4\uB85C
      \uAC00\uC838\uC654\uACE0, \uC2E0\uC785 \uC5F0\uAD6C\uC6D0\uC778 \uD50C\uB808\uC774\uC5B4\uAC00
      AI \uB3C4\uC6B0\uBBF8\uC640 \uD568\uAED8 \uC138\uD3EC \uC18D\uC73C\uB85C \uB4E4\uC5B4\uAC00
      \uC6D0\uC778\uC744 \uCC3E\uB294\uB2E4."
    beats:
    - line: "\uBC29\uAE08 \uBCD1\uC6D0\uC5D0\uC11C \uAE09\uD55C \uC5F0\uB77D\uC774
        \uC654\uC5B4. \uD55C \uD658\uC790\uC758 \uD3D0\uC5D0\uC11C \uC138\uD3EC \uB369\uC5B4\uB9AC\uAC00
        \uACC4\uC18D \uCEE4\uC9C0\uACE0 \uC788\uB300."
      mood: 4
      action: 1
      llmPrompt: 
    - line: "\uC774\uC0C1\uD55C \uAC74, \uC6B0\uB9AC \uBAB8\uC774 \uBD84\uBA85 '\uC774\uC81C
        \uADF8\uB9CC \uC790\uB77C'\uB77C\uACE0 \uC2E0\uD638\uB97C \uBCF4\uB0C8\uB294\uB370
        \uADF8 \uC138\uD3EC\uB4E4\uB9CC \uC804\uD600 \uC548 \uB4E3\uB294\uB2E4\uB294
        \uAC70\uC57C."
      mood: 3
      action: 0
      llmPrompt: 
    - line: "\uADF8\uB798\uC11C \uC138\uD3EC\uB97C \uC5EC\uAE30\uB85C \uAC00\uC838\uC654\uC5B4.
        \uC800\uAE30 \uB5A0 \uC788\uB294 \uAC8C \uADF8 \uC138\uD3EC \uC18D\uC5D0\uC11C
        \uAEBC\uB0B8 KRAS \uB2E8\uBC31\uC9C8\uC774\uC57C."
      mood: 2
      action: 2
      llmPrompt: 
    - line: "\uC9C0\uAE08 \uBC18\uC9DD\uC774\uB294 \uC800 \uC790\uB9AC \uBCF4\uC5EC?
        12\uBC88 \uC790\uB9AC\uC57C. \uC124\uACC4\uB3C4\uC5D0\uC11C \uB531 \uD55C
        \uAE00\uC790\uAC00 \uBC14\uB010 \uACF3\uC774\uC9C0."
      mood: 4
      action: 3
      llmPrompt: 
    - line: "\uC5EC\uAE30\uC11C\uBD80\uD130\uAC00 \uC6B0\uB9AC \uC77C\uC774\uC57C.
        \uAE00\uC790 \uD558\uB098 \uB54C\uBB38\uC5D0 \uC65C \uC774\uB7F0 \uC77C\uC774
        \uC0DD\uACBC\uB294\uC9C0 \uAC19\uC774 \uBC1D\uD600\uBCF4\uC790!"
      mood: 3
      action: 4
      llmPrompt: "\uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uBC29\uAE08 \uC0AC\uAC74
        \uD604\uC7A5\uC744 \uBE0C\uB9AC\uD551\uD588\uC5B4\uC694. KRAS\uAC00 \uC138\uD3EC\uC5D0\uC11C
        \uC5B4\uB5A4 \uC2A4\uC704\uCE58 \uC5ED\uD560\uC744 \uD558\uB294\uC9C0, 12\uBC88
        \uC790\uB9AC\uAC00 \uBC14\uB00C\uBA74 \uC65C \uADF8 \uC2A4\uC704\uCE58\uAC00
        \uAEBC\uC9C0\uC9C0 \uC54A\uAC8C \uB418\uB294\uC9C0 \uC77C\uC0C1\uC801\uC778
        \uBE44\uC720\uB85C \uC124\uBA85\uD574\uC8FC\uC138\uC694. \uD574\uACB0 \uBC29\uBC95\uC774\uB098
        \uC57D \uC774\uC57C\uAE30\uB294 \uC544\uC9C1 \uD558\uC9C0 \uB9C8\uC138\uC694."
  stages:
  - stage: 0
    title: "1\uD654 \xB7 \uC0AC\uAC74 \uD604\uC7A5"
    objective: "\uC138\uD3EC \uC18D\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC11C, \uC774\uC0C1
      \uC2E0\uD638\uAC00 \uC2DC\uC791\uB41C KRAS \uB2E8\uBC31\uC9C8\uC758 12\uBC88
      \uC790\uB9AC\uB97C \uCC3E\uC544\uBCF4\uC790."
    assistantLines:
    - "\uC5EC\uAE30 \uBCF4\uC774\uB294 \uC138\uD3EC\uB4E4\uC5D0\uC11C \uC774\uC0C1\uD55C
      \uC2E0\uD638\uAC00 \uB098\uC624\uACE0 \uC788\uC5B4. \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC11C
      \uC0B4\uD3B4\uBCF4\uC790."
    - "\uC138\uD3EC \uC18D\uC73C\uB85C \uB354 \uB4E4\uC5B4\uAC00\uBA74, \uC6B0\uB9AC
      \uBAB8\uC758 \uC124\uACC4\uB3C4\uC778 DNA\uAC00 \uB098\uC120 \uBAA8\uC591\uC73C\uB85C
      \uBCF4\uC77C \uAC70\uC57C."
    - "\uC124\uACC4\uB3C4 \uAE00\uC790\uAC00 \uB531 \uD558\uB098 \uBC14\uB00C\uC5C8\uC5B4!
      \uADF8\uB798\uC11C KRAS\uB77C\uB294 \uB2E8\uBC31\uC9C8 \uBAA8\uC591\uC774 \uC0B4\uC9DD
      \uB2EC\uB77C\uC84C\uC9C0."
    hints:
    - "\uBC18\uC9DD\uC774\uB294 \uC790\uB9AC\uAC00 12\uBC88 \uC790\uB9AC\uC57C. \uB098\uC120\uC744
      \uB530\uB77C \uCC9C\uCC9C\uD788 \uC704\uB85C \uC0B4\uD3B4\uBD10."
    - "\uBC14\uB010 \uAE00\uC790\uB294 \uB531 \uD558\uB098\uBFD0\uC774\uC57C \u2014
      \uC544\uC8FC \uC791\uC740 \uCC28\uC774\uAC00 \uD070 \uBB38\uC81C\uB97C \uB9CC\uB4E4\uC5C8\uC5B4."
    llmContext: "KRAS\uB294 '\uC774\uC81C \uC790\uB77C\uB3C4 \uB3FC!'\uB77C\uB294
      \uC2E0\uD638\uB97C \uBCF4\uB0C8\uB2E4\uAC00 \uB2E4\uC2DC \uAEBC\uC9C0\uB294
      \uC2A4\uC704\uCE58 \uC5ED\uD560 \uB2E8\uBC31\uC9C8\uC774\uB2E4. 12\uBC88 \uC790\uB9AC\uC758
      \uC544\uC8FC \uC791\uC740 \uBD80\uBD84\uC774 \uB2E4\uB978 \uBAA8\uC591\uC73C\uB85C
      \uBC14\uB00C\uBA74 \uC2A4\uC704\uCE58\uAC00 \uAEBC\uC9C0\uC9C0 \uC54A\uACE0
      \uACC4\uC18D \uCF1C\uC9C4 \uC0C1\uD0DC\uB85C \uB0A8\uB294\uB2E4. \uADF8\uB7EC\uBA74
      \uC138\uD3EC\uAC00 \uBA48\uCD94\uC9C0 \uC54A\uACE0 \uACC4\uC18D \uC790\uB77C\uB09C\uB2E4.
      \uC911\uD559\uC0DD\uC5D0\uAC8C\uB294 '\uACE0\uC7A5 \uB098\uC11C \uACC4\uC18D
      \uB20C\uB824\uC788\uB294 \uC2A4\uC704\uCE58' \uBE44\uC720\uB85C \uC124\uBA85\uD558\uBA74
      \uC774\uD574\uD558\uAE30 \uC27D\uB2E4."
  - stage: 1
    title: "2\uD654 \xB7 \uB2E8\uBC31\uC9C8 \uD0D0\uC815"
    objective: "\uC815\uC0C1 \uB2E8\uBC31\uC9C8\uACFC \uC774\uC0C1\uD574\uC9C4 \uB2E8\uBC31\uC9C8\uC758
      \uBAA8\uC591\uC744 \uBE44\uAD50\uD558\uACE0, AI\uAC00 \uC5B4\uB514\uB97C \uC790\uC2E0
      \uC788\uAC8C \uC608\uCE21\uD588\uB294\uC9C0 \uC0C9\uAE54\uB85C \uD655\uC778\uD574\uBCF4\uC790."
    assistantLines:
    - "\uBC14\uB010 \uC124\uACC4\uB3C4\uB300\uB85C \uB2E8\uBC31\uC9C8\uC774 \uC0C8\uB85C
      \uB9CC\uB4E4\uC5B4\uC838. \uC0AC\uC2AC\uC774 \uC811\uD788\uBA74\uC11C \uC785\uCCB4
      \uBAA8\uC591\uC774 \uB418\uB294 \uAC78 \uC9C0\uCF1C\uBCF4\uC790."
    - "\uB2E4 \uC811\uD788\uBA74 \uC0C9\uAE54 \uC9C0\uB3C4\uAC00 \uCF1C\uC9C8 \uAC70\uC57C.
      \uC774 \uC0C9\uC740 AI\uAC00 \uC774 \uBD80\uBD84 \uBAA8\uC591\uC744 \uC5BC\uB9C8\uB098
      \uC790\uC2E0 \uC788\uAC8C \uC608\uCE21\uD588\uB294\uC9C0 \uBCF4\uC5EC\uC918."
    - "\uD2B9\uD788 \uC774 \uADFC\uCC98\uAC00 \uB9CE\uC774 \uD754\uB4E4\uB9AC\uB124.
      \uC5EC\uAE30\uAC00 \uC6B0\uB9AC\uAC00 \uB208\uC5EC\uACA8\uBD10\uC57C \uD560
      \uC790\uB9AC\uC57C."
    hints:
    - "\uC815\uC0C1 \uB2E8\uBC31\uC9C8\uACFC \uC774\uC0C1 \uB2E8\uBC31\uC9C8\uC744
      \uB098\uB780\uD788 \uB450\uACE0 12\uBC88 \uC790\uB9AC\uB9CC \uBE44\uAD50\uD574\uBD10."
    - "\uC0C9\uC774 \uB178\uB797\uAC70\uB098 \uBE68\uAC04 \uACF3\uC740 AI\uB3C4 \uD655\uC2E0\uC774
      \uC5C6\uB2E4\uB294 \uB73B\uC774\uB2C8 \uC870\uC2EC\uD574\uC11C \uC0B4\uD3B4\uBCF4\uC790."
    llmContext: "AlphaFold\uB77C\uB294 AI\uAC00 \uB2E8\uBC31\uC9C8\uC758 3D \uBAA8\uC591\uC744
      \uC608\uCE21\uD588\uACE0, \uC0C9\uC740 pLDDT\uB77C\uB294 \uC608\uCE21 \uC2E0\uB8B0\uB3C4
      \uC810\uC218\uB97C \uBCF4\uC5EC\uC900\uB2E4(\uD30C\uB791=\uC790\uC2E0 \uC788\uC74C,
      \uBE68\uAC15\xB7\uC8FC\uD669=\uC790\uC2E0 \uC5C6\uC74C). Switch-I, Switch-II\uB77C
      \uBD80\uB974\uB294 \uBD80\uBD84\uC740 \uC2E4\uC81C\uB85C \uC798 \uC6C0\uC9C1\uC774\uB294
      \uBD80\uBD84\uC774\uB77C \uC2E0\uB8B0\uB3C4\uAC00 \uB0AE\uAC8C \uB098\uC624\uB294\uB370,
      \uC774 '\uC798 \uC6C0\uC9C1\uC784'\uC774 \uB098\uC911\uC5D0 \uC57D\uBB3C\uC774
      \uB4E4\uC5B4\uAC08 \uD2C8\uC744 \uB9CC\uB4E0\uB2E4."
  - stage: 2
    title: "3\uD654 \xB7 \uC228\uC740 \uC5F4\uC1E0 \uAD6C\uBA4D"
    objective: "\uB2E8\uBC31\uC9C8 \uC548\uCABD\uC5D0 \uC228\uC5B4\uC788\uB294 \uC791\uC740
      '\uC5F4\uC1E0 \uAD6C\uBA4D'\uACFC, \uC0C8\uB85C \uC0DD\uAE34 \uD2B9\uBCC4\uD55C
      \uC6D0\uC790\uB97C \uCC3E\uC544 \uD45C\uC2DC\uD574\uBCF4\uC790."
    assistantLines:
    - "\uB2E8\uBC31\uC9C8 \uD45C\uBA74\uC744 \uC9C0\uB098 \uC548\uCABD \uBE48 \uACF5\uAC04\uC73C\uB85C
      \uB4E4\uC5B4\uAC00 \uBCFC\uAC8C. \uC774 \uC790\uB9AC\uAC00 \uBC14\uB85C \uC5F4\uC1E0
      \uAD6C\uBA4D\uC774\uC57C."
    - "12\uBC88 \uC790\uB9AC\uC5D0 \uC0C8\uB85C \uC0DD\uAE34 \uB178\uB780 \uC6D0\uC790\uAC00
      \uBCF4\uC774\uC9C0? \uC800\uAC8C \uC6B0\uB9AC\uAC00 \uB178\uB9AC\uB294 \uD2B9\uBCC4\uD55C
      \uC790\uB9AC\uC57C."
    - "\uC774 \uC6D0\uC790\uB294 \uB2E4\uB978 \uAC83\uACFC \uC544\uC8FC \uC798 \uB2EC\uB77C\uBD99\uC5B4.
      \uC5EC\uAE30\uC5D0 \uB531 \uB9DE\uB294 \uC5F4\uC1E0\uB97C \uAF42\uC73C\uBA74
      \uB450 \uBC88 \uB2E4\uC2DC \uC548 \uD480\uB9AC\uB294 \uACB0\uD569\uC744 \uB9CC\uB4E4
      \uC218 \uC788\uC5B4."
    hints:
    - "\uC774 \uC5F4\uC1E0 \uAD6C\uBA4D\uC740 \uC815\uC0C1 \uB2E8\uBC31\uC9C8\uC5D0\uB294
      \uAC70\uC758 \uC5C6\uC5B4. \uBAA8\uC591\uC774 \uBC14\uB010 \uB2E8\uBC31\uC9C8\uC5D0\uC11C\uB9CC
      \uC0C8\uB85C \uC5F4\uB824."
    - "12\uBC88 \uC790\uB9AC\uB97C \uCC3E\uC544\uBD10. \uB178\uB780\uBE5B \uC6D0\uC790\uAC00
      \uC5F4\uC1E0 \uAD6C\uBA4D \uC548\uCABD\uC744 \uD5A5\uD558\uACE0 \uC788\uC5B4."
    llmContext: "\uC774 \uC790\uB9AC\uB294 KRAS G12C\uC5D0\uC11C\uB9CC \uC5F4\uB9AC\uB294
      \uD2B9\uBCC4\uD55C \uD3EC\uCF13(Switch-II Pocket)\uC774\uB2E4. 12\uBC88 \uC790\uB9AC\uC5D0
      \uC0C8\uB85C \uC0DD\uAE34 \uC2DC\uC2A4\uD14C\uC778\uC774\uB77C\uB294 \uC544\uBBF8\uB178\uC0B0\uC758
      \uD669 \uC6D0\uC790\uAC00 \uBC18\uC751\uC131\uC774 \uB192\uC544, \uC5EC\uAE30\uC5D0
      \uB531 \uB9DE\uB294 \uBD84\uC790\uB97C \uAC78\uBA74 \uB418\uB3CC\uB9B4 \uC218
      \uC5C6\uC774(\uACF5\uC720\uACB0\uD569) \uBD99\uC7A1\uC744 \uC218 \uC788\uB2E4.
      \uC815\uC0C1 \uB2E8\uBC31\uC9C8\uC5D0\uB294 \uC774 \uD669 \uC6D0\uC790\uAC00
      \uC5C6\uC5B4 \uAC19\uC740 \uBC29\uBC95\uC744 \uC4F8 \uC218 \uC5C6\uB2E4 \u2014
      \uADF8\uB798\uC11C \uC774 \uC804\uB7B5\uC740 \uC774 \uB3CC\uC5F0\uBCC0\uC774\uC5D0\uB9CC
      \uD1B5\uD55C\uB2E4."
  - stage: 3
    title: "4\uD654 \xB7 \uB531 \uB9DE\uB294 \uC5F4\uC1E0 \uACE0\uB974\uAE30"
    objective: "\uD6C4\uBCF4\uBB3C\uC9C8 4\uC885 \uC911, \uC5F4\uC1E0 \uAD6C\uBA4D\uC5D0
      \uB9DE\uACE0 \uD2B9\uBCC4\uD55C \uC6D0\uC790\uC640\uB3C4 \uB2E8\uB2E8\uD788
      \uBD99\uB294 \uC9C4\uC9DC \uC5F4\uC1E0\uB97C \uCC3E\uC544\uBCF4\uC790."
    assistantLines:
    - "\uD6C4\uBCF4\uBB3C\uC9C8 \uB124 \uAC1C\uB97C \uC900\uBE44\uD588\uC5B4. \uD558\uB098\uC529
      \uC5F4\uC1E0 \uAD6C\uBA4D\uC5D0 \uAC00\uC838\uB2E4 \uB300 \uBCF4\uC790."
    - "\uAD6C\uBA4D\uC5D0 \uB4E4\uC5B4\uAC00\uB294 \uAC83\uB9CC\uC73C\uB85C\uB294
