      \uD655\uC778\uD558\uACE0 \uC0AC\uAC74\uC744 \uB9C8\uBB34\uB9AC\uD558\uC790."
    assistantLines:
    - "\uc6d0\uc790 \uc18d \uc138\uacc4\uc5d0\uc11c \ub098\uc640\uc11c \ub2e4\uc2dc \uc5f0\uad6c\uc2e4\ub85c \ub3cc\uc544\uc654\uc5b4\uc694."
    - "\ud654\uba74\uc5d0 \uacb0\uacfc\uac00 \ub5b4\uc5b4\uc694! \uc774\uc0c1 \uc2e0\ud638\ub97c \ub0b4\ub358 \uc138\ud3ec\ub294 \uc904\uc5b4\ub4e4\uace0, \uc815\uc0c1 \uc138\ud3ec\ub294 \uadf8\ub300\ub85c \uc798 \uc9c0\ub0b4\uace0 \uc788\uc5b4\uc694."
    - "\uc815\uc0c1 \ub2e8\ubc31\uc9c8\uc740 \uac74\ub4dc\ub9ac\uc9c0 \uc54a\uc558\uc73c\ub2c8 \ubd80\uc791\uc6a9\ub3c4 \uc801\uc744 \uac70\uc608\uc694."
    hints:
    - "\ud639\uc2dc \uacb0\uacfc \ud654\uba74\uc5d0\uc11c '\ub0b4\uc131'\uc774\ub77c\ub294 \ub9d0\uc774 \ubcf4\uc774\uba74, \uc138\ud3ec\uac00 \ub610 \ub2e4\ub978 \ubc29\ubc95\uc73c\ub85c \uc800\ud56d\ud560 \uc218\ub3c4 \uc788\ub2e4\ub294 \ub73b\uc774\uc5d0\uc694."
    llmContext: "G12C\uC5D0\uB9CC \uB531 \uB9DE\uB294 \uC5B5\uC81C\uC81C\uB294 \uC815\uC0C1
