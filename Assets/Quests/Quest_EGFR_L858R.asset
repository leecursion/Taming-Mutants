    client: "\uD749\uBD80\uC678\uACFC \uB3C4\uD604 \uC120\uC0DD\uB2D8"
    premise: "\uAC00\uC0C1\uC758 \uC0AC\uAC74\uC774\uB2E4. \uB2F4\uBC30\uB97C \uD55C
